# Copy this file to .env and fill in the values.
# Command-line flags (e.g. in cheesegull.bat) override these values.

# osu! API
OSU_API_KEY=Your_Bancho_APIKEY
OSU_USERNAME=Your_Bancho_username
OSU_PASSWORD=Your_Bancho_password

# MySQL / Sphinx
MYSQL_DSN=root:@(127.0.0.1:3306)/cheesegull
SEARCH_DSN=root:@(127.0.0.1:3306)/cheesegull

# Server
HTTP_ADDR=0.0.0.0:6201
DATA_FOLDERS=/data/
MAXIMUM_DISK=10
SECRET_CI=Your_CIKey
DOWNLOAD_HOSTNAME=osu.ppy.sh

# Discord webhook for new beatmap notifications (leave empty to disable)
DISCORD_WEBHOOK_URL=

# Max osu! API requests per minute for cheesegull's own workers (0 = unlimited, original behaviour)
OSU_RATE_LIMIT=60
